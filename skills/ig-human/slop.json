{
  "version": "1.0",
  "note": "Language-independent part of the lexicon: invisible characters, typography, and the structural tells that do not depend on a language. Word lists live in lex/<lang>.json and only apply to text in that language. Characters a language really uses (French no-break spaces, Arabic direction marks, the joiner inside an emoji) are kept by lang.py whatever this file says.",
  "invisible": [
    {
      "cp": "U+200B",
      "name": "ZERO WIDTH SPACE",
      "action": "delete"
    },
    {
      "cp": "U+200C",
      "name": "ZERO WIDTH NON-JOINER",
      "action": "delete"
    },
    {
      "cp": "U+200D",
      "name": "ZERO WIDTH JOINER",
      "action": "delete"
    },
    {
      "cp": "U+2060",
      "name": "WORD JOINER",
      "action": "delete"
    },
    {
      "cp": "U+FEFF",
      "name": "ZERO WIDTH NO-BREAK SPACE / BOM",
      "action": "delete"
    },
    {
      "cp": "U+00AD",
      "name": "SOFT HYPHEN",
      "action": "delete"
    },
    {
      "cp": "U+180E",
      "name": "MONGOLIAN VOWEL SEPARATOR",
      "action": "delete"
    },
    {
      "cp": "U+061C",
      "name": "ARABIC LETTER MARK",
      "action": "delete"
    },
    {
      "cp": "U+200E",
      "name": "LEFT-TO-RIGHT MARK",
      "action": "delete"
    },
    {
      "cp": "U+200F",
      "name": "RIGHT-TO-LEFT MARK",
      "action": "delete"
    },
    {
      "cp": "U+E0000-U+E007F",
      "name": "TAG CHARACTERS (invisible ASCII smuggling)",
      "action": "delete"
    },
    {
      "cp": "U+00A0",
      "name": "NO-BREAK SPACE",
      "action": "space"
    },
    {
      "cp": "U+202F",
      "name": "NARROW NO-BREAK SPACE",
      "action": "space"
    },
    {
      "cp": "U+2009",
      "name": "THIN SPACE",
      "action": "space"
    },
    {
      "cp": "U+2007",
      "name": "FIGURE SPACE",
      "action": "space"
    },
    {
      "cp": "U+2003",
      "name": "EM SPACE",
      "action": "space"
    },
    {
      "cp": "U+2002",
      "name": "EN SPACE",
      "action": "space"
    },
    {
      "cp": "U+2063",
      "name": "INVISIBLE SEPARATOR",
      "action": "delete"
    }
  ],
  "typographic": [
    {
      "from": "—",
      "name": "EM DASH",
      "to": ", "
    },
    {
      "from": "–",
      "name": "EN DASH",
      "to": "-"
    },
    {
      "from": "‘",
      "name": "LEFT SINGLE QUOTE",
      "to": "'"
    },
    {
      "from": "’",
      "name": "RIGHT SINGLE QUOTE",
      "to": "'"
    },
    {
      "from": "“",
      "name": "LEFT DOUBLE QUOTE",
      "to": "\""
    },
    {
      "from": "”",
      "name": "RIGHT DOUBLE QUOTE",
      "to": "\""
    },
    {
      "from": "…",
      "name": "HORIZONTAL ELLIPSIS",
      "to": "..."
    },
    {
      "from": "′",
      "name": "PRIME",
      "to": "'"
    },
    {
      "from": "·",
      "name": "MIDDLE DOT",
      "to": "-"
    },
    {
      "from": "•",
      "name": "BULLET",
      "to": "-"
    },
    {
      "from": "→",
      "name": "RIGHTWARDS ARROW",
      "to": "->"
    }
  ],
  "structures": [
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Rocket / fire / bulb / sparkle / dart emoji",
      "fix": "One emoji max, and not one of these five."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#[\\wÀ-ɏ؀-ۿ]+\\s*){6,}",
      "name": "Hashtag wall (6+, over the cap of 5)",
      "fix": "Instagram counts 5 hashtags at most since December 2025. Keep 3 to 5 that name the topic, below the fold."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Emoji bullet list",
      "fix": "Use a hyphen or a line break. Emoji bullets are the single most template-looking thing in a caption."
    },
    {
      "id": "caps-shout",
      "regex": "\\b[A-Z]{3,}\\b(?:\\s+\\b[A-Z]{3,}\\b){2,}",
      "name": "Three or more shouted words in a row",
      "fix": "Caps are a volume knob, not a highlighter. One word, at most."
    }
  ]
}
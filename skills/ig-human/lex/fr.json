  "structures": [
    {
      "id": "fr-pas-seulement",
      "name": "« Ce n'est pas seulement X, c'est Y »",
      "regex": "(?i)\\bce n['’]est pas (?:seulement|juste|qu['’]une?) [^.!?\\n]{2,60}[,.] c['’]est\\b",
      "fix": "Dis Y directement. Le contraste fabriqué est la signature la plus reconnaissable."
    },
    {
      "id": "fr-non-seulement",
      "name": "« Non seulement X mais aussi Y »",
      "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également)\\b",
      "fix": "Garde la partie la plus forte, coupe l'autre."
    },
    {
      "id": "fr-le-resultat",
      "name": "Question rhétorique seule sur sa ligne",
      "regex": "(?im)^\\s*(?:le résultat|la suite|le pire|le meilleur|le secret)\\s*\\?\\s*$",
      "fix": "Donne le résultat sans l'annoncer."
    },
    {
      "id": "fr-voici-ce-que",
      "name": "« Voici ce que j'ai appris »",
      "regex": "(?i)\\bvoici ce que (?:j['’]ai|nous avons) appris\\b",
      "fix": "Commence par la leçon elle-même."
    },
    {
      "id": "fr-dans-cette-video",
      "name": "Préambule vidéo (« dans cette vidéo, je vais vous montrer »)",
      "regex": "(?i)\\b(?:dans (?:cette|la) (?:vidéo|reel)|aujourd['’]hui je vais (?:te|vous) montrer|je vais (?:te|vous) (?:montrer|expliquer) comment)\\b",
      "fix": "Ouvre directement sur le résultat."
    },
    {
      "id": "fr-follow-bait",
      "name": "Appel réflexe à s'abonner ou identifier",
      "regex": "(?i)\\b(?:abonne-toi pour plus|abonnez-vous pour plus|identifie (?:quelqu['’]un|un ami) qui|double tap si|partage si)\\b",
      "fix": "Une seule demande, liée au post, ou aucune."
    },
    {
      "id": "fr-engagement-bait",
      "name": "Appât d'engagement réflexe en fin de ligne",
      "regex": "(?im)\\b(?:d['’]accord \\?|vous en pensez quoi \\?|qui d['’]autre\\b|j['’]ai tort \\?)\\s*$",
      "fix": "Pose une vraie question, à laquelle on peut répondre en un mot."
    },
    {
      "id": "fr-en-resume",
      "name": "Panneau de conclusion de dissertation",
      "regex": "(?i)(?:^|[.!?]\\s+)(?:en résumé|en conclusion|pour conclure|en somme)\\b",
      "fix": "Supprime le panneau. Si la fin est bonne, elle se voit."
    },
    {
      "id": "fr-triad",
      "name": "Triade de noms abstraits (« la régularité, la créativité et la persévérance »)",
      "regex": "(?i)\\b(?:(?:la|le|l['’]|les)\\s?)?\\w+(?:ité|ence|ance|isme|ment|tion|eur|ude)s?, (?:(?:la|le|l['’]|les)\\s?)?\\w+(?:ité|ence|ance|isme|ment|tion|eur|ude)s?,? et (?:(?:la|le|l['’]|les)\\s?)?\\w+(?:ité|ence|ance|isme|ment|tion|eur|ude)s?\\b",
      "fix": "Garde le plus précis des trois, et donne un exemple."
    },
    {
      "id": "fr-que-ce-soit",
      "name": "« Que ce soit X ou Y »",
      "regex": "(?i)\\bque ce soit\\b[^.!?\\n]{2,60}\\bou\\b",
      "fix": "Choisis à qui tu parles."
    },
    {
      "id": "fr-il-ne-sagit-pas",
      "name": "« Il ne s'agit pas seulement de »",
      "regex": "(?i)\\bil ne s['’]agit pas (?:seulement|juste|uniquement) de\\b",
      "fix": "Dis directement ce dont il s'agit."
    },
    {
      "id": "fr-pret-a",
      "name": "« Prêt à … ? »",
      "regex": "(?im)^\\s*prêt(?:e|s|es)? à [^?\\n]{2,60}\\?",
      "fix": "Supprime la question, donne la première étape."
    },
    {
      "id": "fr-et-si",
      "name": "« Et si je vous disais que »",
      "regex": "(?i)\\bet si je (?:vous|te) disais que\\b",
      "fix": "Dis-le."
    },
    {
      "id": "fr-imaginez",
      "name": "« Imaginez : »",
      "regex": "(?im)^\\s*imagine[sz]?\\s*[:,]",
      "fix": "Raconte ce qui s'est vraiment passé."
    },
    {
      "id": "fr-bonne-nouvelle",
      "name": "Teaser rhétorique (« La bonne nouvelle ? », « Spoiler : »)",
      "regex": "(?im)^\\s*(?:la bonne nouvelle\\s*\\?|spoiler\\s*:)",
      "fix": "Donne la nouvelle sans l'annoncer."
    }
  ]
}